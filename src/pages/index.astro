---
import BaseLayout from '../layouts/BaseLayout.astro';
import VersionStatusBar from '../components/VersionStatusBar.astro';
import { getCollection } from 'astro:content';
import { OFFICIAL_DOCS, OFFICIAL_REPO, formatCheckedDate, withBase } from '../consts';
import versions from '../data/versions.json';

const pages = await getCollection('guide');
const recent = pages
  .filter((page) => !page.data.noindex)
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime())
  .slice(0, 5);
const slugOf = (id: string) => id.replace(/\/index$/, '');
const base = Astro.site ?? new URL('http://localhost:4321');
const siteRoot = new URL(withBase('/'), base).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeepSeek Harness 中文手册',
    url: siteRoot,
    inLanguage: 'zh-CN',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteRoot}search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<BaseLayout
  title="首页"
  description="DeepSeek Harness 中文手册：安装、插件配置、版本差异与排错，每页标注本站核验的 dsh 版本与日期。"
  jsonLd={jsonLd}
  mainClass="home-main"
>
  <section class="hero-banner">
    <div class="hero-banner__inner container">
      <div class="hero-banner__copy">
        <p class="hero-banner__kicker">
          <span class="hero-banner__kicker-brand">DEEPSEEK HARNESS</span>
          <span class="hero-banner__kicker-rule" aria-hidden="true"></span>
          <span class="hero-banner__kicker-cn">中文手册</span>
        </p>
        <h1 class="hero-banner__title">从一条命令，<br />到一棵插件树</h1>
        <p class="hero-banner__lead">dsh（DeepSeek Harness）把模型、工具、插件和你本机的工作目录接在一起运行。这本手册从安装讲到源码，每一步都能自己复核。</p>
        <div class="hero-banner__actions">
          <a class="button button--start" href={withBase('/install/desktop/')}>第一次用：安装桌面版</a>
          <a class="hero-banner__alt" href={withBase('/install/')}>三种安装方式怎么选</a>
        </div>
      </div>

      <div class="hero-art">
        <div class="hero-art__command">
          <span class="hero-art__prompt" aria-hidden="true">$</span>
          <code>npx @deepseek-ai/dsh@latest web</code>
        </div>
        <p class="hero-art__note">需要 Node 与 DeepSeek API Key。启动后浏览器会打开带 token 的地址。<a class="hero-art__note-link" href={withBase('/install/npx/')}>完整步骤</a></p>
        <div class="hero-art__assembly">
          <p class="hero-art__caption">启动时，dsh 在读什么</p>
          <ul class="hero-tree">
            <li>
              <code>profile</code><span>列出要用的组合包</span>
              <ul>
                <li>
                  <code>bundle</code><span>一组配置改动</span>
                  <ul>
                    <li>
                      <code>patch</code><span>按 id 替换配置</span>
                      <ul>
                        <li class="hero-tree__result">
                          <code>loader</code><span>合成运行中的服务</span>
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>
              </ul>
            </li>
          </ul>
        </div>
        <a class="hero-art__link" href={withBase('/source/plugin-tree/')}>看插件树怎样组装</a>
      </div>
    </div>

    <nav class="hero-tracks container" aria-label="三条阅读路线">
      <a class="hero-track hero-track--install" href={withBase('/install/')}>
        <span class="hero-track__meta">
          <span class="hero-track__num">01</span>
          <span class="hero-track__dot" aria-hidden="true"></span>
          <span class="hero-track__tag">INSTALL</span>
        </span>
        <span class="hero-track__name">装起来</span>
        <span class="hero-track__desc">桌面版、npx、源码</span>
      </a>
      <a class="hero-track hero-track--plugins" href={withBase('/plugins/')}>
        <span class="hero-track__meta">
          <span class="hero-track__num">02</span>
          <span class="hero-track__dot" aria-hidden="true"></span>
          <span class="hero-track__tag">PLUGINS</span>
        </span>
        <span class="hero-track__name">接能力</span>
        <span class="hero-track__desc">装插件、写插件、排错</span>
      </a>
      <a class="hero-track hero-track--source" href={withBase('/source/')}>
        <span class="hero-track__meta">
          <span class="hero-track__num">03</span>
          <span class="hero-track__dot" aria-hidden="true"></span>
          <span class="hero-track__tag">SOURCE</span>
        </span>
        <span class="hero-track__name">读源码</span>
        <span class="hero-track__desc">插件树、消息、工具</span>
      </a>
    </nav>
  </section>

  <div class="container">
    <div class="status-strip">
      <span><span class="status-strip__label">核验</span>{formatCheckedDate(versions.checkedAt)}</span>
      <span><span class="status-strip__label">dsh</span><code>{versions.npm.latest}</code></span>
      <a href={withBase('/versions/')}>版本差异</a>
    </div>

    <section class="section">
      <div class="section-intro">
        <h2>你属于哪种情况</h2>
        <p>第一次来就按第一条走；已经装好，直接看卡住或想深入的那条。</p>
      </div>

      <div class="decision-grid">
        <a class="decision-card decision-card--feature" href={withBase('/install/desktop/')}>
          <span class="decision-card__main">
            <span class="decision-card__label">第一次用</span>
            <span class="decision-card__title">先把 dsh 装起来</span>
          </span>
          <span class="decision-card__aside">
            <span class="decision-card__desc">桌面版最省事。想临时试一次可以走 npx；想从源码跑，安装页也写了准备条件。</span>
            <span class="decision-card__go">安装桌面版</span>
          </span>
        </a>
        <a class="decision-card" href={withBase('/plugins/install/')}>
          <span class="decision-card__label">卡住了</span>
          <span class="decision-card__title">插件装不上</span>
          <span class="decision-card__desc">先按现象查报错对照表，再决定从 Web UI、命令行还是本地路径装。</span>
          <span class="decision-card__go">插件安装</span>
        </a>
        <a class="decision-card" href={withBase('/plugins/first-plugin/')}>
          <span class="decision-card__label">想深入</span>
          <span class="decision-card__title">写第一个插件</span>
          <span class="decision-card__desc">先写一个最小插件，确认启动日志里有加载记录，再学注册工具和发布。</span>
          <span class="decision-card__go">最小插件</span>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-intro">
        <h2>装完先做这三件事</h2>
        <p>顺序不重要，但三件都做完，Web UI 才算真的能用。</p>
      </div>
      <ol class="task-list">
        <li>
          <span class="task-list__num">01</span>
          <div>
            <h3>填 API Key</h3>
            <p>API Key 是一串用来调用 DeepSeek 模型的访问口令。打开设置 → 模型，在 DeepSeek 卡片里填入并保存；保存后的下一次请求就会用到它，不需要重启服务。见 <a href={withBase('/models/')}>模型配置</a>。</p>
          </div>
        </li>
        <li>
          <span class="task-list__num">02</span>
          <div>
            <h3>选工作区</h3>
            <p>dsh 把工作区当作默认的读写位置，第一次启动后要在界面里选一次。没有选工作区时，界面上的输入框不可用。</p>
          </div>
        </li>
        <li>
          <span class="task-list__num">03</span>
          <div>
            <h3>装一个插件，确认插件装上了</h3>
            <p>profile 是 dsh 的一个配置目录，一个 profile 装一套插件。装完不显示，多半是插件装进了另一个 profile：先确认插件装进了哪个 profile，再确认 Web UI 用的是同一个。见 <a href={withBase('/plugins/install/')}>插件安装</a>。</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="section" id="source">
      <div class="section-intro">
        <h2>读源码：三条主线</h2>
        <p>源码文章固定到 <code>{versions.github.tag}</code> 的 commit，行号只对那份源码有效。</p>
      </div>
      <ol class="source-grid">
        <li>
          <a class="source-card" href={withBase('/source/plugin-tree/')}>
            <span class="source-card__num">01</span>
            <strong class="source-card__title">插件树的组装过程</strong>
            <span class="source-card__desc">profile、bundle、patch 逐层合成运行中的服务；base 组合包是共享的第一层，里面有 96 行配置。</span>
            <span class="source-card__go">读这一篇</span>
          </a>
        </li>
        <li>
          <a class="source-card" href={withBase('/source/message-lifecycle/')}>
            <span class="source-card__num">02</span>
            <strong class="source-card__title">一条消息怎样变成一个步骤</strong>
            <span class="source-card__desc">一条消息从被领取、组装提示词、冻结请求，到流式返回和写入日志，中间会留下哪些记录。</span>
            <span class="source-card__go">读这一篇</span>
          </a>
        </li>
        <li>
          <a class="source-card" href={withBase('/source/tool-pipeline/')}>
            <span class="source-card__num">03</span>
            <strong class="source-card__title">一次工具调用要过哪些关卡</strong>
            <span class="source-card__desc">模型要用工具时，一次调用要按顺序经过审批、各项守卫、执行和后置处理，最后冻结成一条结果；调用被拒绝也算一种结果。</span>
            <span class="source-card__go">读这一篇</span>
          </a>
        </li>
      </ol>
    </section>

    <div class="split">
      <section class="section">
        <h2>最近更新</h2>
        <ul class="recent">
          {recent.map((page) => (
            <li>
              <a href={withBase(`/${slugOf(page.id)}/`)}>{page.data.title}</a>
              <time datetime={new Date(page.data.updated).toISOString().slice(0, 10)}>{new Date(page.data.updated).toISOString().slice(0, 10)}</time>
            </li>
          ))}
        </ul>
      </section>

      <section class="section">
        <h2>核验方法</h2>
        <p>能在本机运行的命令，都在 Windows 11 + Node 24 的环境下执行过一次，本站把这种情况标为“实测”；本机跑不了的步骤按官方文档核对，并在页面上写明。每页头部标注核验到的 dsh 版本与核验日期，超过 30 天会显示提示条。</p>
        <h3>权威来源</h3>
        <ul class="links">
          <li><a href={OFFICIAL_DOCS} rel="noopener">官方文档</a>：dsh 的术语和接口定义以官方文档为准。</li>
          <li><a href={OFFICIAL_REPO} rel="noopener">官方仓库</a>：dsh 的源码和版本发布记录都在官方仓库。</li>
        </ul>
      </section>
    </div>

    <VersionStatusBar />
  </div>
</BaseLayout>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--hero-border);
    background: var(--hero-bg);
  }
  .hero-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--hero-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    pointer-events: none;
  }
  .hero-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--hero-grain);
    pointer-events: none;
  }
  .hero-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: center;
    gap: 64px;
    padding-block: 56px 40px;
  }
  .hero-banner__copy {
    max-width: 560px;
  }
  .hero-banner__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    line-height: 1;
  }
  .hero-banner__kicker-brand {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--hero-kicker);
  }
  .hero-banner__kicker-rule {
    width: 20px;
    height: 1px;
    background: linear-gradient(90deg, var(--hero-rule), transparent);
  }
  .hero-banner__kicker-cn {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--hero-kicker-cn);
  }
  .hero-banner__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 62px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: 0.01em;
    color: var(--hero-title);
    word-break: keep-all;
  }
  .hero-banner__lead {
    max-width: 32em;
    margin: 20px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--hero-body);
  }
  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-top: 30px;
  }
  .button--start {
    display: inline-flex;
    align-items: center;
    padding: var(--hero-button-padding);
    border: 1px solid var(--hero-button-border);
    border-bottom: var(--hero-button-underline-width) solid var(--hero-button-underline);
    border-radius: var(--hero-button-radius);
    background: var(--hero-button-bg);
    color: var(--hero-button-ink);
    font-size: var(--hero-button-size);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--hero-button-shadow);
    -webkit-backdrop-filter: var(--hero-button-glass);
    backdrop-filter: var(--hero-button-glass);
    transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .button--start:hover,
  .button--start:focus-visible {
    background: var(--hero-button-hover-bg);
    border-color: var(--hero-button-hover-border);
    border-bottom-color: var(--hero-button-hover-underline);
    box-shadow: var(--hero-button-hover-shadow);
    transform: translateY(-1px);
  }
  .hero-banner__alt {
    color: var(--hero-alt);
    font-size: 14px;
    text-decoration-color: var(--hero-alt-line);
    text-underline-offset: 4px;
  }
  .hero-banner__alt:hover {
    color: var(--hero-alt-hover);
    text-decoration-color: var(--hero-alt-hover-line);
  }

  .hero-art {
    justify-self: end;
    width: 100%;
    max-width: 500px;
    padding: 20px 22px 18px;
    border: 1px solid var(--hero-art-border);
    border-radius: 10px;
    background: var(--hero-art-bg);
    box-shadow: var(--hero-art-shadow);
    -webkit-backdrop-filter: var(--hero-glass);
    backdrop-filter: var(--hero-glass);
  }
  .hero-art__command {
    display: flex;
    gap: 10px;
    align-items: baseline;
    overflow-x: auto;
    padding: 12px 14px;
    border: 1px solid var(--hero-command-border);
    border-radius: 6px;
    background: var(--hero-command-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .hero-art__prompt {
    color: var(--hero-result);
  }
  .hero-art__command code {
    color: var(--hero-command-ink);
    font-family: var(--font-mono);
  }
  .hero-art__note {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--hero-art-muted);
  }
  .hero-art__note-link {
    color: var(--hero-link);
    text-decoration-color: var(--hero-link-line);
    text-underline-offset: 3px;
  }
  .hero-art__note-link:hover {
    color: var(--hero-link-hover);
    text-decoration-color: var(--hero-link-hover-line);
  }
  .hero-art__assembly {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--hero-line);
  }
  .hero-art__caption {
    margin: 0 0 8px;
    font-size: 12px;
    color: var(--hero-art-muted);
  }
  .hero-tree,
  .hero-tree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero-tree ul {
    padding-left: 18px;
    border-left: 1px solid var(--hero-line);
  }
  .hero-tree li {
    position: relative;
    padding: 3px 0 3px 14px;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .hero-tree li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14px;
    width: 10px;
    height: 1px;
    background: var(--hero-line);
  }
  .hero-tree > li {
    padding-left: 0;
  }
  .hero-tree > li::before {
    display: none;
  }
  .hero-tree code {
    margin-right: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--hero-tree-code);
  }
  .hero-tree span {
    color: var(--hero-tree-muted);
  }
  .hero-tree__result code,
  .hero-tree__result span {
    color: var(--hero-result);
  }
  .hero-tree__result code {
    text-shadow: 0 0 16px color-mix(in srgb, var(--hero-result) 35%, transparent);
  }
  .hero-art__link {
    display: inline-block;
    margin-top: 12px;
    color: var(--hero-link);
    font-size: 12.5px;
    text-decoration: none;
    border-bottom: 1px solid var(--hero-link-line);
  }
  .hero-art__link:hover {
    color: var(--hero-link-hover);
    border-bottom-color: var(--hero-link-hover-line);
  }

  .hero-tracks {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding-bottom: 26px;
  }
  .hero-track {
    --track-color: var(--dot-1);
    display: flex;
    flex-direction: column;
    padding: 13px 16px 14px;
    border: 1px solid var(--hero-card-border);
    border-radius: 10px;
    background: var(--hero-card-bg);
    box-shadow: var(--hero-card-shadow);
    -webkit-backdrop-filter: var(--hero-glass);
    backdrop-filter: var(--hero-glass);
    color: var(--hero-card-ink);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  .hero-track--install {
    --track-color: var(--dot-1);
  }
  .hero-track--plugins {
    --track-color: var(--dot-2);
  }
  .hero-track--source {
    --track-color: var(--dot-3);
  }
  .hero-track:hover,
  .hero-track:focus-visible {
    transform: translateY(-2px);
    border-color: var(--hero-card-hover-border);
  }
  .hero-track__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 7px;
  }
  .hero-track__num {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--hero-card-muted);
  }
  .hero-track__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--track-color);
    box-shadow: 0 0 10px color-mix(in srgb, var(--track-color) 55%, transparent);
  }
  .hero-track__tag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--hero-card-muted);
  }
  .hero-track__name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--hero-card-ink);
  }
  .hero-track__desc {
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--hero-card-muted);
  }

  .status-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px var(--space-6);
    margin-top: var(--space-6);
    padding: 0 0 14px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-faint);
  }
  .status-strip__label {
    margin-right: 6px;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .status-strip code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-soft);
  }
  .status-strip a {
    color: var(--ink-faint);
  }
  .status-strip a:hover {
    color: var(--accent);
  }

  .section {
    margin-top: var(--space-8);
  }
  .section-intro {
    max-width: 68ch;
    margin-bottom: var(--space-5);
  }
  .section-intro h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .section-intro p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .decision-grid {
    display: grid;
